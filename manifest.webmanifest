{
  "name": "Hafen",
  "short_name": "Hafen",
  "description": "Unsere gemeinsame App: Reisen und mehr, auch offline.",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ECEFE9",
  "theme_color": "#12343B",
  "lang": "de",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Tickets", "url": "./#/travel/tickets", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Unterkünfte", "url": "./#/travel/stays", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "share_title", "text": "share_text", "url": "share_url" }
  }
}
